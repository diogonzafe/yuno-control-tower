REDIS_URL=redis://default:password@localhost:6379
DATABASE_URL=postgresql://postgres:password@localhost:5432/control_tower
BUCKET_NAME=example-bucket
BUCKET_URL=https://example-storage.invalid
BUCKET_REGION=auto

OPENAI_API_KEY=sk-example-not-a-real-key
# rules.md §6.4.1 locks three DIFFERENT models (investigator / narrator /
# reserve). The three ids below are identical, which silently defeats the
# §6.8 rate-limit defense: if the narrator's model is throttled mid-demo, the
# "reserve" is the same throttled model. Set the reserve to a different one —
# and verify the exact strings against the provider docs first, as §6.4.1 warns.
INVESTIGATOR_MODEL=openai/gpt-5.6-sol
NARRATOR_MODEL=openai/gpt-5.6-terra
NARRATOR_FALLBACK_MODEL=openai/gpt-5.6-luna
AGENT_MAX_TOOL_CALLS=12
AGENT_TIMEOUT_MS=45000
# rules.md §3 boundary #3: every agentic path has a deterministic fallback, so
# this ships on and only "false" turns it off. Off, a failed investigation stops
# at the failed run — the incident keeps the deterministic evidence the tick
# already wrote, but gets no narrative. Operator kill switch, not a setting.
AGENT_FALLBACK_ENABLED=true

# packages/web
# When true, the Control Tower UI renders hand-built fixture incidents
# (open/monitoring/resolved/inconclusive) instead of hitting /api/stream and
# /api/catalog — useful for developing the frontend without a running
# detect/diagnose pipeline, so `incidents` stays empty. Restart `next dev`
# after changing this.
NEXT_PUBLIC_USE_FIXTURES=false

# packages/generator
GENERATOR_TRAFFIC_WEIGHTS={"AR_STORE_01":1,"AR_STORE_02":1,"AR_STORE_03":1,"BR_STORE_01":1,"BR_STORE_02":1,"BR_STORE_03":1,"MX_STORE_01":1,"MX_STORE_02":1,"MX_STORE_03":1}
GENERATOR_INJECT_PORT=4100
# Caps the Redis stream at XADD time (MAXLEN ~). XACK does not delete entries
# and nothing XDELs or XTRIMs, so without this the stream keeps every
# transaction of the run in Redis memory until the instance dies. Default
# 200000 (~2.5h at the default TPS); 0 is not accepted — drop the cap only by
# editing emit.ts, deliberately.
GENERATOR_STREAM_MAXLEN=200000
# Average transactions per second; default 60 if unset. Keep a ceiling on this:
# the ingest consumer drains ~41 events/s against cloud Redis + cloud Postgres,
# and transactionsPerSecond multiplies baseTps by a seasonal factor peaking at
# ~1.74x (hour 18 UTC). A baseTps whose peak exceeds the drain rate builds an
# unbounded stream backlog, so the ingest keeps writing rollup buckets that are
# further and further in the past and the detector never sees a current window —
# it goes blind while /health still reports the ingest as up.
# 20 keeps the peak at ~35/s; anything above ~23 outruns the consumer at peak.
GENERATOR_BASE_TPS=20
# Applied to every merchant's expected conversion; default 0.90 if unset.
GENERATOR_DEFAULT_CONVERSION=0.90
# When true, each merchant's conversion is randomized +/-0.05 around the default.
GENERATOR_RANDOMIZE_CONVERSION=false
# How many incidents the generator auto-injects and keeps active for the whole run.
GENERATOR_AUTO_INCIDENTS=0
# When true, auto-injected incidents use a fresh (non-reproducible) seed each run.
GENERATOR_RANDOMIZE_INCIDENTS=false

# packages/app
APP_PORT=4000
# How long rows stay in `transactions`. Nothing reads that table — the detector
# and the API run off the rollups — but the insert's ON CONFLICT DO NOTHING is
# what stops a redelivered Redis batch from double-counting the rollups, so the
# window is also the dedup window: keep it hours, not minutes. Unpruned the
# table grows ~2M rows/day at the default TPS and fills the volume, which stops
# Postgres mid-recovery ("No space left on device") and takes the app with it.
# 0 turns retention off and accepts that growth.
TRANSACTIONS_RETENTION_MINUTES=180
# How often the prune runs. Each run deletes at most 100k rows (20 batches of
# 5000), so a large backlog drains over several runs instead of in one DELETE
# big enough to be its own disk incident.
TRANSACTIONS_RETENTION_INTERVAL_MINUTES=10
