REDIS_URL=redis://default:password@localhost:6379
DATABASE_URL=postgresql://postgres:password@localhost:5432/control_tower
BUCKET_NAME=example-bucket
BUCKET_URL=https://example-storage.invalid
BUCKET_REGION=auto

# packages/web
# When true, the Control Tower UI renders hand-built fixture incidents
# (open/monitoring/resolved/inconclusive) instead of hitting /api/stream and
# /api/catalog — useful for developing the frontend while the orchestrator
# (packages/app/src/orchestrate/*) isn't merged yet, so `incidents` stays empty.
# Restart `next dev` after changing this.
NEXT_PUBLIC_USE_FIXTURES=false

# packages/generator
GENERATOR_TRAFFIC_WEIGHTS={"AR_STORE_01":1,"AR_STORE_02":1,"AR_STORE_03":1,"BR_STORE_01":1,"BR_STORE_02":1,"BR_STORE_03":1,"MX_STORE_01":1,"MX_STORE_02":1,"MX_STORE_03":1}
GENERATOR_INJECT_PORT=4100
# Applied to every merchant's expected conversion; default 0.90 if unset.
GENERATOR_DEFAULT_CONVERSION=0.90
# When true, each merchant's conversion is randomized +/-0.05 around the default.
GENERATOR_RANDOMIZE_CONVERSION=false
# How many incidents the generator auto-injects and keeps active for the whole run.
GENERATOR_AUTO_INCIDENTS=0
# When true, auto-injected incidents use a fresh (non-reproducible) seed each run.
GENERATOR_RANDOMIZE_INCIDENTS=false
